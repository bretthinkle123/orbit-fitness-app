# Allowlist: everything is excluded unless re-included below, so a new sensitive file
# (.env.local, *.tfstate, .pipeline/, private-docs/, .git/) can never reach the build
# context by accident. A denylist would fail open.
*
!pyproject.toml
!poetry.lock
!README.md
!src/
!migrations/
!alembic.ini
**/__pycache__
