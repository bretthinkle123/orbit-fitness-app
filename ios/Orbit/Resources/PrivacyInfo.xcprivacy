<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Nutrition-label data map (AC32 / SC-1). Every category collected
	     is scoped to App Functionality only — no advertising, no
	     third-party analytics/tracking SDK is in this app. Reconciled
	     against `.pipeline/plan.md` §Data / CLAUDE.md's "Row-level
	     ownership (owner key = Firebase UID); no local PII beyond the
	     UID (email/display name stay in Firebase)": the backend stores no
	     email/display-name field of its own, only the opaque UID + the
	     fitness/diet records themselves, all owner-scoped to that UID. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Firebase Auth account email/password (identity provider only —
		     never sent to/stored by the Orbit backend itself). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The Firebase UID — the single owner key every domain row is
		     scoped to (CLAUDE.md "row-level ownership"). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Train domain: logged sets/exercises. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Weight + Fuel (food/macro) domains. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required-Reason APIs (AC32 / SC-9). This app's OWN source never
	     references `UserDefaults` (the token lives in the Keychain,
	     `Core/KeychainStore.swift` — CLAUDE.md/plan.md: "never
	     `UserDefaults` for the token"), but the bundled Firebase Auth SDK
	     is documented by Apple/Firebase to access it internally, so the
	     category is declared here regardless of which side of the
	     boundary the actual call sits on. Reason `CA92.1`: accessing
	     UserDefaults to read/write information only accessible to the
	     app itself. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
