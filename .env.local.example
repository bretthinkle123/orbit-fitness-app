# Local-stack configuration. Copy to .env.local (gitignored) and replace every CHANGE_ME.
# Compose reads this file only through `docker compose --env-file .env.local ...`; the
# helper scripts parse it strictly (no shell sourcing). Generate a secret with:
#   openssl rand -hex 24

# Postgres container: role and database names (lowercase letters, digits, underscore).
POSTGRES_USER=orbit
POSTGRES_DB=orbit
# Postgres password: 16-128 characters of letters, digits, underscore or hyphen.
POSTGRES_PASSWORD=CHANGE_ME

# Dev account seeded into the Firebase Auth emulator by dev-up.
ORBIT_DEV_USER_EMAIL=dev@orbit-fitness.test
# 12-128 printable ASCII characters, no spaces.
ORBIT_DEV_USER_PASSWORD=CHANGE_ME
